//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <140>;
};

/ {
    combos {
        compatible = "zmk,combos";

        clear_all_bt {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <0 1 3 2 4 5 6 7 8 9>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <7 6>;
        };

        right-esc {
            bindings = <&kp ESCAPE>;
            key-positions = <8 9>;
        };

        left-esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        right-bsp {
            bindings = <&kp BACKSPACE>;
            key-positions = <27 28>;
        };

        left-bsp {
            bindings = <&kp BACKSPACE>;
            key-positions = <24 23>;
        };

        left-enter {
            bindings = <&kp ENTER>;
            key-positions = <3 2>;
        };

        left-hanja {
            bindings = <&kp RCTRL>;
            key-positions = <1 2>;
        };

        left-del {
            bindings = <&kp DELETE>;
            key-positions = <23 22>;
        };

        combo-layer {
            bindings = <&mo 4>;
            key-positions = <33 34>;
        };

        right-del {
            bindings = <&kp DELETE>;
            key-positions = <29 28>;
        };

        right-caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <7 8>;
        };

        left-sp {
            bindings = <&kp SPACE>;
            key-positions = <23 22 24>;
        };

        right-tab {
            bindings = <&kp TAB>;
            key-positions = <27 28 29>;
        };

        game {
            bindings = <&to 5>;
            key-positions = <21 22 23 24 25>;
        };

        bt-layer {
            bindings = <&mo 6>;
            key-positions = <0 1 2 3 4>;
        };
    };

    behaviors {
        shiftalt_bsp: shiftalt_bsp {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFTALT_BSP";
            #binding-cells = <0>;
            tapping-term-ms = <170>;
            bindings = <&mt LS(LEFT_ALT) BACKSPACE>, <&kp BACKSPACE>;
        };

        ctrlshift_enter: ctrlshift_enter {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRLSHIFT_ENTER";
            #binding-cells = <0>;
            tapping-term-ms = <170>;
            bindings = <&mt LS(LEFT_ALT) ENTER>, <&kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "BASE";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     F     ┃     P     ┃     G     ┃   ┃     J     ┃     L     ┃     U     ┃     Y     ┃     ;     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     A     ┃     R     ┃     S     ┃     T     ┃     D     ┃   ┃     H     ┃     N     ┃     E     ┃     I     ┃     O     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃     Q     ┃     Z     ┃     X     ┃     C     ┃     V     ┃     B     ┃   ┃     K     ┃     M     ┃     ,     ┃     .     ┃     /     ┃     \     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    DEL    ┃    TAB    ┃    SPC    ┃   ┃   ENTER   ┃           ┃   BSPC    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
                &kp Q               &kp W           &kp E         &kp R        &kp T         &kp Y       &kp U        &kp I          &kp O           &kp QUESTION
                &mt LEFT_CONTROL A  &mt LEFT_ALT S  &mt LSHIFT D  &mt LCTRL F  &mt LWIN G    &mt LWIN H  &mt LCTRL J  &mt LSHFT K    &mt LEFT_ALT L  &mt LCTRL P
&sk LEFT_SHIFT  &kp Z               &kp X           &kp C         &kp V        &kp B         &kp B       &kp N        &kp M          &kp COMMA       &kp PERIOD    &sk LEFT_SHIFT
                                                    &kp TAB       &mo 3        &mo 2         &mo 1       &kp SPACE    &kp RIGHT_ALT
            >;
        };

        NAV {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans  &kp HOME  &kp PAGE_DOWN  &kp PG_UP       &kp END
        &trans  &trans  &trans  &trans  &trans    &trans  &kp LEFT  &kp UP_ARROW   &kp DOWN_ARROW  &kp RIGHT
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans         &trans          &trans     &trans
                        &trans  &trans  &trans    &trans  &trans    &trans
            >;
        };

        sym-num-1 {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "sym-num-1";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃           ┃           ┃     UP    ┃           ┃     {     ┃   ┃     }     ┃     7     ┃     8     ┃     9     ┃     +     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   SHIFT   ┃   LEFT    ┃    DOWN   ┃   RIGHT   ┃     [     ┃   ┃     ]     ┃     4     ┃     5     ┃     6     ┃     -     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃   P UP    ┃  C LOCK   ┃  P DOWN   ┃     (     ┃   ┃     )     ┃     1     ┃     2     ┃     3     ┃     *     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    TAB    ┃    SPC    ┃   ┃    DEL    ┃     0     ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
        &kp AMPS          &kp ASTERISK     &kp UNDERSCORE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET        &kp PLUS      &kp N7        &kp N8        &kp N9        &kp LCTRL
        &kp SINGLE_QUOTE  &kp SLASH        &kp EQUAL       &kp MINUS             &kp PLUS                 &kp MINUS     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp COMMA
&trans  &kp PERCENT       &kp EXCLAMATION  &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp ASTERISK  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp SLASH
                                           &trans          &trans                &trans                   &trans        &trans        &kp N0
            >;
        };

        sym-num-2 {
            bindings = <
        &kp PIPE    &kp CARET        &trans     &kp LESS_THAN      &kp GREATER_THAN    &trans  &kp F9  &kp F10  &kp F11  &kp F12
        &kp GRAVE   &kp NON_US_BSLH  &kp COLON  &kp DOUBLE_QUOTES  &kp SEMICOLON       &trans  &kp F5  &kp F6   &kp F7   &kp F8
&trans  &kp DOLLAR  &kp AT           &kp HASH   &kp LEFT_BRACE     &kp RIGHT_BRACE     &trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans
                                     &trans     &trans             &trans              &trans  &trans  &trans
            >;

            label = "sym-num-2";
        };

        left-char {
            bindings = <
        &mt EXCLAMATION QUESTION  &kp O      &kp I   &kp U   &kp Y     &trans  &trans  &trans  &trans  &trans
        &kp P                     &kp L      &kp K   &kp J   &kp H     &trans  &trans  &trans  &trans  &trans
&trans  &kp PERIOD                &kp COMMA  &kp M   &kp N   &kp B     &trans  &trans  &trans  &trans  &trans  &trans
                                             &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_6 {
            label = "game";
            bindings = <
             &kp Q  &kp W  &kp E      &kp R      &kp T             &kp Y   &kp U   &kp I   &kp O      &kp QUESTION
             &kp A  &kp S  &kp D      &kp F      &kp G             &kp H   &kp J   &kp K   &kp L      &kp P
&kp LA(TAB)  &kp Z  &kp X  &kp C      &kp V      &kp B             &kp B   &kp N   &kp M   &kp COMMA  &kp PERIOD    &sk LEFT_SHIFT
                           &kp LCTRL  &kp SPACE  &kp LEFT_SHIFT    &trans  &trans  &trans
            >;
        };

        bt {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &bt BT_CLR    &trans        &trans        &trans        &trans
        &trans  &trans  &trans  &trans  &trans    &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
                        &trans  &trans  &trans    &trans        &trans        &trans
            >;
        };
    };
};
